# ─── Base de datos ────────────────────────────────────────────────────────────
# En Railway: Railway inyecta DATABASE_URL automáticamente desde el servicio PostgreSQL.
# NO sobreescribas esta variable en el panel de Railway — bórrala si la importaste.
# Solo úsala localmente con Docker Compose.
DATABASE_URL="postgresql://studypath:studypath123@localhost:5432/studypath_db"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET="cambia-este-secreto-minimo-32-caracteres-aqui"
JWT_EXPIRES_IN="7d"

# ─── GROQ (LLM — generación de rutas en tiempo de ejecución) ─────────────────
# Obtén tu API key GRATIS en: https://console.groq.com/keys
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GROQ_MODEL="llama-3.3-70b-versatile"

# ─── Google AI (embeddings — solo al ejecutar: npx prisma db seed) ───────────
# Obtén tu API key GRATIS en: https://aistudio.google.com/app/apikey
# No se necesita en tiempo de ejecución (el RAG usa vector-cero como fallback)
GOOGLE_AI_API_KEY="AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMBEDDING_MODEL="text-embedding-004"
EMBEDDING_DIMENSIONS=768

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL="http://localhost:3001/api"
