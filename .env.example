# ─── Base de datos ────────────────────────────────────────────────────────────
# Local: PostgreSQL de Docker Compose.
# Producción (Render): cadena de conexión de Neon SIN pooler (sin "-pooler" en el host)
# y con ?sslmode=require, p. ej. postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://studypath:studypath123@localhost:5432/studypath_db"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET="cambia-este-secreto-minimo-32-caracteres-aqui"
JWT_EXPIRES_IN="7d"

# ─── GROQ (LLM — generación de rutas en tiempo de ejecución) ─────────────────
# Obtén tu API key GRATIS en: https://console.groq.com/keys
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GROQ_MODEL="openai/gpt-oss-120b"

# ─── Google AI (embeddings — seed Y búsqueda RAG en tiempo de ejecución) ─────
# Obtén tu API key GRATIS en: https://aistudio.google.com/app/apikey
# Sin esta key las rutas se generan sin contexto recuperado.
# Si cambias EMBEDDING_MODEL, vuelve a ejecutar el seed (npm run db:seed).
GOOGLE_AI_API_KEY="AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMBEDDING_MODEL="gemini-embedding-001"
# Similitud coseno mínima (0-1) para usar un chunk como contexto
RAG_MIN_SIMILARITY=0.6

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Producción: URL del frontend en Vercel. Admite varios orígenes separados por coma.
CORS_ORIGIN="http://localhost:5173"

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Producción (Vercel): URL de la API en Render, p. ej. https://studypath-api.onrender.com/api
VITE_API_URL="http://localhost:3001/api"
